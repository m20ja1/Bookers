<h1>Books</h1>

  <p>Title</p>
  <p>Body</p>

<% @books.each do |book| %>
  <span><%= book.title %></span>
  <span><%= book.body %></span>


<%= link_to 'Show', book_path(book.id) %>
<%= link_to 'Edit', edit_book_path(book.id) %>
<%= link_to 'Destroy', book_path(book.id), data: {turbo_method: :delete, turbo_confirm: "Are you sure ?" } %>

<% end %>


<h1>New book</h1>

<% if @book.errors.any? %>
  <%= @book.errors.count %>error prohibited this book from being saved:
  <ul>
    <% @book.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %> 

<%= form_with model:@book do |f| %>
  <p>Title</p>
  <%= f.text_field :title %>
  <p>Body</p>
  <%= f.text_area :body %>

  <%= f.submit 'Create Book' %>
<% end %>